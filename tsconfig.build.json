{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noUncheckedIndexedAccess": false, "esModuleInterop": true, "skipLibCheck": true,
    "resolveJsonModule": true, "declaration": true, "sourceMap": true, "outDir": "dist", "rootDir": "src",
    "verbatimModuleSyntax": false, "allowImportingTsExtensions": false, "types": ["node"]
  },
  "include": ["src"]
}
